import { Theme, LunaCard, PillBadge, FlatButton, FlatIconButton } from "theme.slint";
import { UiMediaItem } from "types.slint";

export component HomeTab inherits VerticalLayout {
    spacing: 16px;
    padding: 16px;
    alignment: start;

    in-out property <bool> replay-active: false;
    in-out property <int> replay-progress: 0;
    in-out property <string> replay-buffer-label: "0s / 30s";
    in-out property <string> replay-ram-label: "0 MB / 512 MB";
    in-out property <string> replay-hotkey-label: "Alt + F8";
    in-out property <bool> can-save-clip: false;
    in-out property <bool> saving-clip: false;
    in-out property <string> last-saved-label: "";
    in-out property <bool> capturing-replay: false;

    in-out property <bool> recording: false;
    in-out property <string> record-status-label: "Inativa";
    in-out property <string> record-hotkey-label: "Alt + F9";
    in-out property <bool> shared-session: false;
    in-out property <string> restart-hint: "";
    in-out property <bool> capturing-record: false;

    in-out property <[UiMediaItem]> recent-items: [];
    in property <length> available-width: 720px;
    property <int> usable-grid-width: (root.available-width - 64px) / 1px;
    property <int> visible-cols: Math.clamp(Math.floor((usable-grid-width + 14) / 234), 3, 6);

    callback toggle-replay();
    callback save-clip();
    callback toggle-record();
    callback start-capture-replay();
    callback start-capture-record();
    callback cancel-capture();
    callback open-media(string);
    callback navigate-to-gallery();

    // Seção Superior: Cards de Replay e Gravação lado a lado
    HorizontalLayout {
        spacing: 16px;
        height: 210px;
        vertical-stretch: 0;

        // Card 1: Replay
        LunaCard {
            horizontal-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: space-between;

                // Título e Status
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Replay";
                        color: Theme.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    PillBadge {
                        text: root.replay-active ? "Ativo" : "Inativo";
                        bg: root.replay-active ? Theme.emerald-muted : Theme.surface-elevated;
                        fg: root.replay-active ? Theme.emerald : Theme.text-secondary;
                        border-col: root.replay-active ? Theme.emerald : Theme.border;
                    }
                }

                // Barra de progresso flat
                VerticalLayout {
                    spacing: 6px;
                    Rectangle {
                        height: 8px;
                        background: Theme.surface-elevated;
                        border-radius: 4px;

                        Rectangle {
                            x: 0px;
                            width: root.replay-active ? ((parent.width * root.replay-progress) / 100) : 0px;
                            height: parent.height;
                            background: Theme.accent;
                            border-radius: 4px;
                        }
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.replay-buffer-label;
                            color: Theme.text-secondary;
                            font-size: 11px;
                        }
                        Text {
                            text: root.replay-ram-label;
                            color: Theme.text-muted;
                            font-size: 11px;
                        }
                    }
                }

                // Atalho de teclado
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Atalho:";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if !root.capturing-replay : HorizontalLayout {
                        spacing: 8px;
                        PillBadge {
                            text: root.replay-hotkey-label;
                            bg: Theme.surface-elevated;
                            fg: Theme.text-primary;
                            border-col: Theme.border-active;
                        }
                        FlatIconButton {
                            text: "Alterar";
                            clicked => { root.start-capture-replay(); }
                        }
                    }
                    if root.capturing-replay : HorizontalLayout {
                        spacing: 8px;
                        PillBadge {
                            text: "Pressione as teclas...";
                            bg: Theme.accent-muted;
                            fg: Theme.accent-hover;
                            border-col: Theme.accent;
                        }
                        FlatIconButton {
                            text: "Cancelar";
                            clicked => { root.cancel-capture(); }
                        }
                    }
                }

                // Botões de Ação
                HorizontalLayout {
                    spacing: 10px;
                    FlatButton {
                        horizontal-stretch: 1;
                        text: root.saving-clip ? "Salvando clipe..." : "Salvar Clipe";
                        primary: true;
                        disabled: !root.can-save-clip || root.saving-clip;
                        clicked => { root.save-clip(); }
                    }
                    FlatButton {
                        horizontal-stretch: 1;
                        text: root.replay-active ? "Desativar Replay" : "Iniciar Replay";
                        primary: false;
                        clicked => { root.toggle-replay(); }
                    }
                }

                if root.last-saved-label != "" : Text {
                    text: root.last-saved-label;
                    color: Theme.emerald;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }

        // Card 2: Gravação
        LunaCard {
            horizontal-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: space-between;

                // Título e Status
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Gravação";
                        color: Theme.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    PillBadge {
                        text: root.recording ? "Gravando" : "Inativa";
                        bg: root.recording ? Theme.emerald-muted : Theme.surface-elevated;
                        fg: root.recording ? Theme.emerald : Theme.text-secondary;
                        border-col: root.recording ? Theme.emerald : Theme.border;
                    }
                }

                // Duração decorrida quando ativa ou espaçador balanceado quando inativa
                if root.recording : Rectangle {
                    height: 28px;
                    background: Theme.surface-elevated;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.emerald;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;
                        Text {
                            text: "Tempo decorrido:";
                            color: Theme.text-secondary;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.record-status-label;
                            color: Theme.emerald;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                if !root.recording : Rectangle {
                    height: 28px;
                }

                // Atalho de teclado
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Atalho:";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if !root.capturing-record : HorizontalLayout {
                        spacing: 8px;
                        PillBadge {
                            text: root.record-hotkey-label;
                            bg: Theme.surface-elevated;
                            fg: Theme.text-primary;
                            border-col: Theme.border-active;
                        }
                        FlatIconButton {
                            text: "Alterar";
                            clicked => { root.start-capture-record(); }
                        }
                    }
                    if root.capturing-record : HorizontalLayout {
                        spacing: 8px;
                        PillBadge {
                            text: "Pressione as teclas...";
                            bg: Theme.accent-muted;
                            fg: Theme.accent-hover;
                            border-col: Theme.accent;
                        }
                        FlatIconButton {
                            text: "Cancelar";
                            clicked => { root.cancel-capture(); }
                        }
                    }
                }

                // Botão Iniciar / Finalizar Gravação
                FlatButton {
                    text: root.recording ? "Finalizar Gravação" : "Iniciar Gravação";
                    primary: !root.recording;
                    danger: root.recording;
                    clicked => { root.toggle-record(); }
                }

                if root.restart-hint != "" : Text {
                    text: root.restart-hint;
                    color: Theme.accent-hover;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }
    }

    // Seção Inferior: Capturas Recentes
    LunaCard {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Cabeçalho da seção
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Capturas Recentes";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                FlatIconButton {
                    text: "Ver todas na Galeria ->";
                    clicked => { root.navigate-to-gallery(); }
                }
            }

            if root.recent-items.length == 0 : Rectangle {
                background: Theme.surface-elevated;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.border;
                height: 100px;

                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "Nenhuma captura recente encontrada em ~/Vídeos/Luna.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }

            if root.recent-items.length > 0 : Flickable {
                horizontal-stretch: 1;
                height: 185px;
                content-width: recent-items-layout.preferred-width;
                content-height: 185px;

                recent-items-layout := HorizontalLayout {
                    spacing: 14px;
                    alignment: start;

                    for idx in Math.min(root.recent-items.length, root.visible-cols) : Rectangle {
                        property <UiMediaItem> item: root.recent-items[idx];
                        horizontal-stretch: 1;
                        min-width: 150px;
                        max-width: 220px;
                        height: 185px;
                        background: Theme.surface-elevated;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: recent-touch.has-hover ? Theme.border-active : Theme.border;

                    recent-touch := TouchArea {
                        clicked => { root.open-media(item.path); }
                        mouse-cursor: pointer;
                    }

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: space-between;

                        // Preview da miniatura 16:9 (204px x 115px)
                        Rectangle {
                            height: 115px;
                            background: #0D0D0D;
                            border-radius: 4px;
                            clip: true;

                            if item.has-thumbnail : Image {
                                width: 100%;
                                height: 100%;
                                source: item.thumbnail;
                                image-fit: cover;
                            }

                            if !item.has-thumbnail : Rectangle {
                                background: #161616;
                                Text {
                                    text: item.format-label;
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }

                            // Camada de Badges sobre a miniatura
                            VerticalLayout {
                                padding: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    alignment: start;
                                    PillBadge {
                                        text: item.kind-label;
                                        bg: item.is-clip ? Theme.accent : Theme.surface-elevated;
                                        fg: #FFFFFF;
                                        border-col: transparent;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: end;
                                    PillBadge {
                                        text: item.duration-label;
                                        bg: #000000;
                                        fg: #FFFFFF;
                                        border-col: transparent;
                                    }
                                }
                            }
                        }

                        // Metadados do item
                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: item.title;
                                color: Theme.text-primary;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: item.date-label;
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                }
                                Text {
                                    text: item.size-label;
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }
}
