import { Theme, LunaCard } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct UiClipItem {
    file-name: string,
    path: string,
    game: string,
    recorded-at: string,
    size-label: string,
}

export component ClipsTab inherits VerticalLayout {
    spacing: 10px;

    in property <[UiClipItem]> clips: [];
    in property <bool> undo-banner-visible: false;

    callback open-clip(string);
    callback delete-clip(string);
    callback undo-delete-clip();
    callback open-clips-dir();

    // Cabeçalho da aba
    HorizontalLayout {
        height: 28px;
        alignment: space-between;

        Text {
            text: root.clips.length == 1 ? "1 clipe salvo" : "\{root.clips.length} clipes salvos";
            color: Theme.text-secondary;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Rectangle {
            width: 90px;
            height: 26px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 6px;

            TouchArea {
                clicked => { root.open-clips-dir(); }
                Text {
                    text: "Abrir pasta";
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Lista de clipes ou estado vazio
    if root.clips.length == 0: LunaCard {
        VerticalLayout {
            padding: 32px;
            spacing: 8px;
            alignment: center;

            Text {
                text: "Nenhum clipe gravado ainda";
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            Text {
                text: "Ative o Replay Buffer e pressione Alt+F10 durante a jogatina.";
                color: Theme.text-muted;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }
    }

    if root.clips.length > 0: ScrollView {
        VerticalLayout {
            spacing: 6px;

            for item in root.clips: LunaCard {
                height: 54px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: item.game;
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: item.recorded-at;
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                            Text {
                                text: "·";
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                            Text {
                                text: item.size-label;
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        Rectangle {
                            width: 64px;
                            height: 26px;
                            background: Theme.surface-elevated;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: 5px;

                            TouchArea {
                                clicked => { root.open-clip(item.path); }
                                Text {
                                    text: "Assistir";
                                    color: Theme.text-primary;
                                    font-size: 11px;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            width: 58px;
                            height: 26px;
                            background: Theme.surface;
                            border-radius: 5px;

                            TouchArea {
                                clicked => { root.delete-clip(item.path); }
                                Text {
                                    text: "Excluir";
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Barra inline de Desfazer exclusão
    if root.undo-banner-visible: Rectangle {
        background: Theme.surface-elevated;
        border-width: 1px;
        border-color: Theme.border-active;
        border-radius: 8px;
        height: 38px;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            alignment: space-between;

            Text {
                text: "Clipe removido";
                color: Theme.text-secondary;
                font-size: 12px;
                vertical-alignment: center;
            }

            TouchArea {
                width: 64px;
                clicked => { root.undo-delete-clip(); }
                Text {
                    text: "Desfazer";
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }
    }
}
