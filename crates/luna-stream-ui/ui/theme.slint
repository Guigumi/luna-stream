// Tema Luna: paleta canônica do site, tipografia e componentes base.

export global Theme {
    out property <color> background: #141414;
    out property <color> surface: #1A1A1A;
    out property <color> surface-elevated: #222222;
    out property <color> border: #2C2C2C;
    out property <color> border-active: #3A3A3A;
    out property <color> accent: #EB4141;
    out property <color> accent-hover: #F55A5A;
    out property <color> emerald: #10B981;
    out property <color> crimson: #EB4141;
    out property <color> text-primary: #F5F5F5;
    out property <color> text-secondary: #A0A0A0;
    out property <color> text-muted: #646464;
}

export component LunaCard inherits Rectangle {
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 10px;
}

export component PillBadge inherits Rectangle {
    in property <string> text;
    in property <color> bg: Theme.surface-elevated;
    in property <color> fg: Theme.text-secondary;
    in property <color> border-col: Theme.border;

    background: bg;
    border-width: 1px;
    border-color: border-col;
    border-radius: 6px;
    height: 22px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            color: root.fg;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}
