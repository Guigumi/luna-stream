// Tema canônico Luna Stream: paleta flat 100% sólida, tipografia e componentes base.
// Invariantes estritas: zero degradês, zero animações piscantes/pulsantes, zero emojis Unicode.

export global Theme {
    out property <color> background: #141414;
    out property <color> sidebar: #181818;
    out property <color> surface: #1F1F1F;
    out property <color> surface-elevated: #282828;
    out property <color> surface-hover: #303030;
    out property <color> border: #2C2C2C;
    out property <color> border-active: #3E3E3E;
    out property <color> accent: #EB4141;
    out property <color> accent-hover: #F55A5A;
    out property <color> accent-muted: #5A1E1E;
    out property <color> emerald: #22C55E;
    out property <color> emerald-muted: #144026;
    out property <color> text-primary: #FFFFFF;
    out property <color> text-secondary: #A0A0A0;
    out property <color> text-muted: #646464;
    out property <color> danger: #EB4141;
}

export component LunaCard inherits Rectangle {
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 8px;
}

export component PillBadge inherits Rectangle {
    in property <string> text;
    in property <color> bg: Theme.surface-elevated;
    in property <color> fg: Theme.text-secondary;
    in property <color> border-col: Theme.border;

    background: bg;
    border-width: 1px;
    border-color: border-col;
    border-radius: 4px;
    height: 20px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;

        Text {
            text: root.text;
            color: root.fg;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> disabled: false;
    in property <length> custom-height: 36px;
    callback clicked();

    height: custom-height;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.disabled ? Theme.border :
                  root.danger ? (touch.has-hover ? Theme.accent-hover : Theme.accent) :
                  root.primary ? (touch.has-hover ? Theme.accent-hover : Theme.accent) :
                  (touch.has-hover ? Theme.border-active : Theme.border);

    background: root.disabled ? Theme.surface-elevated :
                root.danger ? (touch.has-hover ? Theme.accent-hover : Theme.accent) :
                root.primary ? (touch.has-hover ? Theme.accent-hover : Theme.accent) :
                (touch.has-hover ? Theme.surface-elevated : Theme.surface);

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.disabled ? default : pointer;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: root.disabled ? Theme.text-muted :
                   (root.primary || root.danger) ? #FFFFFF :
                   Theme.text-primary;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component FlatIconButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;
    in property <bool> disabled: false;
    in property <length> custom-height: 24px;
    callback clicked();

    height: custom-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.active ? Theme.accent : (touch.has-hover ? Theme.border-active : Theme.border);
    background: root.active ? Theme.surface-elevated : (touch.has-hover ? Theme.surface-elevated : Theme.surface);

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.disabled ? default : pointer;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;
        Text {
            text: root.text;
            color: root.disabled ? Theme.text-muted : (root.active ? Theme.accent : Theme.text-primary);
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component FlatFilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : (touch.has-hover ? Theme.border-active : Theme.border);
    background: root.selected ? Theme.accent-muted : (touch.has-hover ? Theme.surface-elevated : Theme.surface);

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.text;
            color: root.selected ? Theme.accent-hover : Theme.text-secondary;
            font-size: 11px;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
        }
    }
}

// Linha interna do menu do FlatSelect (componente privado deste arquivo)
component SelectRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 30px;
    border-radius: 4px;
    background: root.selected ? Theme.accent-muted : (row-touch.has-hover ? Theme.surface-hover : transparent);

    row-touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            color: root.selected ? Theme.accent-hover : Theme.text-primary;
            font-size: 12px;
            font-weight: root.selected ? 700 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component FlatSelect inherits Rectangle {
    in property <[string]> options: [];
    in property <bool> has-all-option: false;
    in property <string> all-label: "Todos";
    in property <string> placeholder: "Selecionar";
    in-out property <int> selected-index: 0;
    callback selected(index: int);

    out property <int> item-count: root.options.length + (root.has-all-option ? 1 : 0);
    out property <int> option-offset: root.has-all-option ? 1 : 0;
    out property <string> current-label:
        root.has-all-option && root.selected-index == 0
            ? root.all-label
            : (root.selected-index >= 0 && root.selected-index < root.item-count
                ? root.options[root.selected-index - root.option-offset]
                : root.placeholder);

    min-width: 120px;
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent : (field-touch.has-hover ? Theme.border-active : Theme.border);
    background: Theme.surface;

    accessible-role: combobox;

    fs := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == "\u{1b}" && popup.is-open) {
                popup.close();
                return accept;
            }
            if (event.text == " " || event.text == "\u{0d}") {
                popup.show();
                return accept;
            }
            if (event.text == "\u{f701}" && root.selected-index + 1 < root.item-count) {
                root.selected(root.selected-index + 1);
                return accept;
            }
            if (event.text == "\u{f700}" && root.selected-index > 0) {
                root.selected(root.selected-index - 1);
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            text: root.current-label;
            color: root.item-count == 0 ? Theme.text-muted : Theme.text-primary;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        Path {
            width: 10px;
            height: 6px;
            vertical-stretch: 0;
            viewbox-width: 10;
            viewbox-height: 6;
            commands: "M 1 1 L 5 5 L 9 1";
            stroke: Theme.text-secondary;
            stroke-width: 2px;
            fill: transparent;
        }
    }

    field-touch := TouchArea {
        clicked => {
            fs.focus();
            if (popup.is-open) {
                popup.close();
            } else if (root.item-count > 0) {
                popup.show();
            }
        }
        mouse-cursor: pointer;
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(root.item-count, 8) * 30px + 8px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface-elevated;
            border-width: 1px;
            border-color: Theme.border-active;
            border-radius: 6px;
            clip: true;

            Flickable {
                content-width: self.width;
                content-height: select-list.preferred-height;

                select-list := VerticalLayout {
                    padding: 4px;
                    spacing: 0;

                    if root.has-all-option : SelectRow {
                        label: root.all-label;
                        selected: root.selected-index == 0;
                        clicked => {
                            root.selected(0);
                            popup.close();
                        }
                    }

                    for opt[index] in root.options : SelectRow {
                        label: opt;
                        selected: root.selected-index == index + root.option-offset;
                        clicked => {
                            root.selected(index + root.option-offset);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// Dia do calendário (componente interno)
component CalendarDay inherits Rectangle {
    in property <string> date: "";
    in property <int> day-number: 1;
    in property <bool> current-month: true;
    in property <bool> is-today: false;
    in property <bool> selected: false;
    in property <bool> focused: false;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: 4px;
    background: root.selected ? Theme.accent :
                root.focused ? Theme.surface-hover :
                root.is-today ? Theme.accent-muted :
                touch.has-hover ? Theme.surface-hover : transparent;
    border-width: (root.is-today && !root.selected) || root.focused ? 1px : 0px;
    border-color: Theme.accent;

    touch := TouchArea {
        enabled: root.current-month;
        clicked => { root.clicked(); }
        mouse-cursor: root.current-month ? pointer : default;
    }

    Text {
        text: root.day-number == 0 ? "" : "{root.day-number}";
        color: root.selected ? #FFFFFF :
               root.is-today ? Theme.accent-hover :
               root.current-month ? Theme.text-primary : Theme.text-muted;
        font-size: 12px;
        font-weight: root.is-today || root.selected ? 700 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// Cabeçalho do mês com navegação
component CalendarMonthHeader inherits Rectangle {
    in property <int> year: 2026;
    in property <int> month: 11;
    callback prev-month();
    callback next-month();

    property <string> month-name: [
        "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
        "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"
    ][root.month - 1];

    height: 40px;
    background: transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: space-between;

        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 4px;
            background: prev-touch.has-hover ? Theme.surface-hover : transparent;
            border-width: 1px;
            border-color: prev-touch.has-hover ? Theme.border-active : transparent;

            prev-touch := TouchArea {
                clicked => { root.prev-month(); }
                mouse-cursor: pointer;
            }
            HorizontalLayout { alignment: center;
                Path {
                    width: 10px; height: 6px; viewbox-width: 10; viewbox-height: 6;
                    commands: "M 9 1 L 5 5 L 9 9";
                    stroke: Theme.text-secondary; stroke-width: 2px; fill: transparent;
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: "{root.month-name} {root.year}";
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 4px;
            background: next-touch.has-hover ? Theme.surface-hover : transparent;
            border-width: 1px;
            border-color: next-touch.has-hover ? Theme.border-active : transparent;

            next-touch := TouchArea {
                clicked => { root.next-month(); }
                mouse-cursor: pointer;
            }
            HorizontalLayout { alignment: center;
                Path {
                    width: 10px; height: 6px; viewbox-width: 10; viewbox-height: 6;
                    commands: "M 1 1 L 5 5 L 1 9";
                    stroke: Theme.text-secondary; stroke-width: 2px; fill: transparent;
                }
            }
        }
    }
}

// Rodapé com botões Hoje/Limpar
component CalendarFooter inherits Rectangle {
    in property <bool> show-today-button: true;
    in property <bool> show-clear-button: true;
    callback today-clicked();
    callback clear-clicked();

    height: 44px;
    background: transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: end;

        if root.show-today-button : Rectangle {
            width: 72px;
            height: 28px;
            border-radius: 4px;
            border-width: 1px;
            border-color: today-touch.has-hover ? Theme.border-active : Theme.border;
            background: today-touch.has-hover ? Theme.surface-elevated : Theme.surface;

            today-touch := TouchArea {
                clicked => { root.today-clicked(); }
                mouse-cursor: pointer;
            }
            HorizontalLayout { alignment: center;
                Text {
                    text: "Hoje";
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        if root.show-clear-button : Rectangle {
            width: 72px;
            height: 28px;
            border-radius: 4px;
            border-width: 1px;
            border-color: clear-touch.has-hover ? Theme.border-active : Theme.border;
            background: clear-touch.has-hover ? Theme.surface-elevated : Theme.surface;

            clear-touch := TouchArea {
                clicked => { root.clear-clicked(); }
                mouse-cursor: pointer;
            }
            HorizontalLayout { alignment: center;
                Text {
                    text: "Limpar";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component CalendarPopup inherits Rectangle {
    in-out property <string> selected-date: "";
    in property <bool> show-today-button: true;
    in property <bool> show-clear-button: true;
    in property <int> current-year: 2026;
    in property <int> current-month: 11;
    in property <int> current-day: 8;
    callback date-selected(string);

    property <int> view-year: 2026;
    property <int> view-month: 11;
    out property <string> selected-day: cell-date-from-index(root.focused-cell);
    in-out property <int> focused-cell: 0;
    out property <bool> popup-open: popup.is-open;
    callback popup-show();
    callback popup-close();

    property <[string]> weekday-labels: ["Do", "Se", "Te", "Qu", "Qu", "Se", "Sá"];

    function cell-date-from-index(idx: int) -> string {
        if (idx < root.first-weekday) {
            let day = root.prev-days - root.first-weekday + idx + 1;
            return root.prev-year + "-" + (root.prev-month < 10 ? "0" + root.prev-month : root.prev-month + "") + "-" + (day < 10 ? "0" + day : day + "");
        } else if (idx < root.first-weekday + root.days-in-month) {
            let day = idx - root.first-weekday + 1;
            return root.view-year + "-" + (root.view-month < 10 ? "0" + root.view-month : root.view-month + "") + "-" + (day < 10 ? "0" + day : day + "");
        } else {
            let day = idx - root.first-weekday - root.days-in-month + 1;
            return root.next-year + "-" + (root.next-month < 10 ? "0" + root.next-month : root.next-month + "") + "-" + (day < 10 ? "0" + day : day + "");
        }
    }

    property <int> days-in-month: [
        31,
        (Math.mod(root.view-year, 4) == 0 && (Math.mod(root.view-year, 100) != 0 || Math.mod(root.view-year, 400) == 0)) ? 29 : 28,
        31, 30, 31, 30, 31, 31, 30, 31, 30, 31
    ][root.view-month - 1];

    property <int> first-weekday: {
        let y = root.view-month <= 2 ? root.view-year - 1 : root.view-year;
        let m = root.view-month <= 2 ? root.view-month + 12 : root.view-month;
        let d = 1;
        let k = Math.mod(y, 100);
        let j = y / 100;
        let h = Math.mod((d + (13 * (m + 1)) / 5 + k + k / 4 + j / 4 + 5 * j), 7);
        Math.mod((h + 6), 7)
    }

    property <int> prev-month: root.view-month == 1 ? 12 : root.view-month - 1;
    property <int> prev-year: root.view-month == 1 ? root.view-year - 1 : root.view-year;
    property <int> prev-days: [
        31,
        (Math.mod(root.prev-year, 4) == 0 && (Math.mod(root.prev-year, 100) != 0 || Math.mod(root.prev-year, 400) == 0)) ? 29 : 28,
        31, 30, 31, 30, 31, 31, 30, 31, 30, 31
    ][root.prev-month - 1];

    property <int> next-month: root.view-month == 12 ? 1 : root.view-month + 1;
    property <int> next-year: root.view-month == 12 ? root.view-year + 1 : root.view-year;

    property <string> today-date: "{root.current-year}-{root.current-month:02d}-{root.current-day:02d}";

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 280px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface-elevated;
            border-width: 1px;
            border-color: Theme.border-active;
            border-radius: 8px;
            clip: true;

            VerticalLayout {
                spacing: 0;

                CalendarMonthHeader {
                    year: root.view-year;
                    month: root.view-month;
                    prev-month => {
                        root.view-month = root.view-month == 1 ? 12 : root.view-month - 1;
                        root.view-year = root.view-month == 12 ? root.view-year - 1 : root.view-year;
                    }
                    next-month => {
                        root.view-month = root.view-month == 12 ? 1 : root.view-month + 1;
                        root.view-year = root.view-month == 1 ? root.view-year + 1 : root.view-year;
                    }
                }

                Rectangle {
                    height: 28px;
                    background: transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 0;
                        for label in root.weekday-labels : Text {
                            width: 36px;
                            text: label;
                            color: Theme.text-muted;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-bottom: 8px;
                    spacing: 4px;

                    for row in 6 : HorizontalLayout {
                        spacing: 4px;
                        for col in 7 : CalendarDay {
                            property <int> cell-idx: row * 7 + col;
                            property <bool> is-prev: cell-idx < root.first-weekday;
                            property <bool> is-current: cell-idx >= root.first-weekday && cell-idx < root.first-weekday + root.days-in-month;
                            property <bool> is-next: cell-idx >= root.first-weekday + root.days-in-month;
                            property <int> day-prev: root.prev-days - root.first-weekday + cell-idx + 1;
                            property <int> day-curr: cell-idx - root.first-weekday + 1;
                            property <int> day-next: cell-idx - root.first-weekday - root.days-in-month + 1;
                            property <string> cell-date: is-prev ? "{root.prev-year}-{root.prev-month:02d}-{day-prev:02d}"
                                : is-current ? "{root.view-year}-{root.view-month:02d}-{day-curr:02d}"
                                : "{root.next-year}-{root.next-month:02d}-{day-next:02d}";
                            property <int> day-num: is-prev || is-next ? 0 : day-curr;
                            property <bool> is-today-cell: cell-date == root.today-date;
                            property <bool> is-selected: cell-date == root.selected-date || (root.selected-date == "" && cell-date == root.selected-day && root.selected-day != "");
                            property <bool> is-focused: cell-idx == root.focused-cell;

                            date: cell-date;
                            day-number: day-num;
                            current-month: is-current;
                            is-today: is-today-cell;
                            selected: is-selected;
                            focused: is-focused;
                            clicked => {
                                root.selected-day = cell-date;
                                root.date-selected(cell-date);
                                root.selected-date = cell-date;
                                popup.close();
                            }
                        }
                    }
                }

                CalendarFooter {
                    show-today-button: root.show-today-button;
                    show-clear-button: root.show-clear-button;
                    today-clicked => {
                        root.date-selected(root.today-date);
                        root.selected-date = root.today-date;
                        root.view-year = root.current-year;
                        root.view-month = root.current-month;
                        popup.close();
                    }
                    clear-clicked => {
                        root.date-selected("");
                        root.selected-date = "";
                        root.selected-day = "";
                        popup.close();
                    }
                }
            }
        }
    }

    focus := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == "\u{1b}" && popup.is-open) {
                popup.close();
                return accept;
            }
            if (event.text == "\u{0d}" && popup.is-open) {
                root.date-selected(cell-date-from-index(root.focused-cell));
                root.selected-date = cell-date-from-index(root.focused-cell);
                popup.close();
                return accept;
            }
            if (event.text == "\u{f704}" && popup.is-open) {
                root.view-month = root.view-month == 1 ? 12 : root.view-month - 1;
                root.view-year = root.view-month == 12 ? root.view-year - 1 : root.view-year;
                root.focused-cell = root.first-weekday;
                return accept;
            }
            if (event.text == "\u{f705}" && popup.is-open) {
                root.view-month = root.view-month == 12 ? 1 : root.view-month + 1;
                root.view-year = root.view-month == 1 ? root.view-year + 1 : root.view-year;
                root.focused-cell = root.first-weekday;
                return accept;
            }
            // Arrow key navigation within the calendar grid
            if (event.text == "\u{f702}" && popup.is-open) { // Left
                let new-cell = root.focused-cell > 0 ? root.focused-cell - 1 : 0;
                root.focused-cell = new-cell;
                return accept;
            }
            if (event.text == "\u{f703}" && popup.is-open) { // Right
                let new-cell = root.focused-cell < 41 ? root.focused-cell + 1 : 41;
                root.focused-cell = new-cell;
                return accept;
            }
            if (event.text == "\u{f700}" && popup.is-open) { // Up
                let new-cell = root.focused-cell >= 7 ? root.focused-cell - 7 : 0;
                root.focused-cell = new-cell;
                return accept;
            }
            if (event.text == "\u{f701}" && popup.is-open) { // Down
                let new-cell = root.focused-cell <= 34 ? root.focused-cell + 7 : 41;
                root.focused-cell = new-cell;
                return accept;
            }
            reject
        }
    }

    popup-show => {
        root.focused-cell = root.first-weekday;
        popup.show();
    }

    popup-close => {
        popup.close();
    }

    trigger := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            if (popup.is-open) {
                popup.close();
            } else {
                if (root.selected-date != "") {
                    root.selected-day = root.selected-date;
                } else {
                    root.selected-day = "{root.view-year}-{root.view-month:02d}-01";
                }
                root.focused-cell = root.first-weekday;
                popup.show();
            }
        }
        mouse-cursor: pointer;
    }
}

export component NumericStepper inherits Rectangle {
    in property <int> value: 0;
    in property <int> min-value: 0;
    in property <int> max-value: 999999;
    in property <int> step: 1;
    in property <string> unit: "";
    in property <bool> disabled: false;
    callback value-changed(int);

    height: 36px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 6px;

    HorizontalLayout {
        padding: 2px;
        spacing: 4px;

        Rectangle {
            width: 32px;
            background: minus-touch.has-hover ? Theme.surface-elevated : transparent;
            border-radius: 4px;
            minus-touch := TouchArea {
                enabled: !root.disabled && root.value > root.min-value;
                clicked => {
                    let next = root.value - root.step < root.min-value ? root.min-value : root.value - root.step;
                    root.value-changed(next);
                }
                mouse-cursor: root.disabled ? default : pointer;
            }
            Text {
                text: "-";
                color: (root.disabled || root.value <= root.min-value) ? Theme.text-muted : Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: "\{root.value}";
                color: root.disabled ? Theme.text-muted : Theme.text-primary;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.unit != "" : Text {
                text: root.unit;
                color: Theme.text-secondary;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 32px;
            background: plus-touch.has-hover ? Theme.surface-elevated : transparent;
            border-radius: 4px;
            plus-touch := TouchArea {
                enabled: !root.disabled && root.value < root.max-value;
                clicked => {
                    let next = root.value + root.step > root.max-value ? root.max-value : root.value + root.step;
                    root.value-changed(next);
                }
                mouse-cursor: root.disabled ? default : pointer;
            }
            Text {
                text: "+";
                color: (root.disabled || root.value >= root.max-value) ? Theme.text-muted : Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}