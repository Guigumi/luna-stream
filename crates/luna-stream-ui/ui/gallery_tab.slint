import { ListView } from "std-widgets.slint";
import { Theme, LunaCard, PillBadge, FlatButton, FlatIconButton, FlatFilterChip } from "theme.slint";
import { UiMediaItem } from "types.slint";

export component GalleryTab inherits VerticalLayout {
    spacing: 14px;
    padding: 16px;

    in-out property <[UiMediaItem]> gallery-items: [];
    in-out property <string> confirming-delete-path: "";

    in-out property <string> filter-kind: "all"; // all, clip, recording
    in-out property <string> filter-format: "all"; // all, mp4, mkv
    in-out property <string> sort-field: "recent"; // recent, size, duration
    in-out property <string> sort-order: "desc"; // desc, asc

    callback open-media(string);
    callback request-delete-media(string);
    callback cancel-delete-media();
    callback confirm-delete-media(string);
    callback open-captures-dir();
    callback filter-changed(string, string, string, string, string);
    callback sort-changed(string, string);
    callback refresh-gallery();

    // Barra de Filtros e Ações
    LunaCard {
        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            // Linha 1: Filtros de Tipo e Formato + Ações da pasta
            HorizontalLayout {
                spacing: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Tipo:";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    FlatFilterChip {
                        text: "Todos";
                        selected: root.filter-kind == "all";
                        clicked => {
                            root.filter-kind = "all";
                            root.filter-changed(root.filter-kind, root.filter-format, "all", "all", "all");
                        }
                    }
                    FlatFilterChip {
                        text: "Clipes";
                        selected: root.filter-kind == "clip";
                        clicked => {
                            root.filter-kind = "clip";
                            root.filter-changed(root.filter-kind, root.filter-format, "all", "all", "all");
                        }
                    }
                    FlatFilterChip {
                        text: "Gravações";
                        selected: root.filter-kind == "recording";
                        clicked => {
                            root.filter-kind = "recording";
                            root.filter-changed(root.filter-kind, root.filter-format, "all", "all", "all");
                        }
                    }

                    Rectangle { width: 8px; }

                    Text {
                        text: "Formato:";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    FlatFilterChip {
                        text: "Todos";
                        selected: root.filter-format == "all";
                        clicked => {
                            root.filter-format = "all";
                            root.filter-changed(root.filter-kind, root.filter-format, "all", "all", "all");
                        }
                    }
                    FlatFilterChip {
                        text: "MP4";
                        selected: root.filter-format == "mp4";
                        clicked => {
                            root.filter-format = "mp4";
                            root.filter-changed(root.filter-kind, root.filter-format, "all", "all", "all");
                        }
                    }
                    FlatFilterChip {
                        text: "MKV";
                        selected: root.filter-format == "mkv";
                        clicked => {
                            root.filter-format = "mkv";
                            root.filter-changed(root.filter-kind, root.filter-format, "all", "all", "all");
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    FlatIconButton {
                        text: "Atualizar";
                        clicked => { root.refresh-gallery(); }
                    }
                    FlatIconButton {
                        text: "Abrir Pasta";
                        clicked => { root.open-captures-dir(); }
                    }
                }
            }

            // Linha 2: Ordenação por campo e ordem crescente/decrescente
            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Ordenar por:";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                FlatFilterChip {
                    text: "Recentes";
                    selected: root.sort-field == "recent";
                    clicked => {
                        root.sort-field = "recent";
                        root.sort-changed(root.sort-field, root.sort-order);
                    }
                }
                FlatFilterChip {
                    text: "Tamanho";
                    selected: root.sort-field == "size";
                    clicked => {
                        root.sort-field = "size";
                        root.sort-changed(root.sort-field, root.sort-order);
                    }
                }
                FlatFilterChip {
                    text: "Duração";
                    selected: root.sort-field == "duration";
                    clicked => {
                        root.sort-field = "duration";
                        root.sort-changed(root.sort-field, root.sort-order);
                    }
                }

                Rectangle { width: 8px; }

                FlatFilterChip {
                    text: root.sort-order == "desc" ? "Decrescente" : "Crescente";
                    selected: true;
                    clicked => {
                        if (root.sort-order == "desc") {
                            root.sort-order = "asc";
                        } else {
                            root.sort-order = "desc";
                        }
                        root.sort-changed(root.sort-field, root.sort-order);
                    }
                }
            }
        }
    }

    // Lista de Mídias Rolável
    LunaCard {
        vertical-stretch: 1;

        if root.gallery-items.length == 0 : Rectangle {
            background: transparent;
            HorizontalLayout {
                alignment: center;
                Text {
                    text: "Nenhuma captura encontrada para os filtros selecionados.";
                    color: Theme.text-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }

        if root.gallery-items.length > 0 : ListView {
            for item in root.gallery-items : Rectangle {
                height: 104px;
                background: item-touch.has-hover ? Theme.surface-elevated : Theme.surface;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }

                item-touch := TouchArea {
                    mouse-cursor: default;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 16px;
                    alignment: space-between;

                    // Miniatura 16:9 à esquerda
                    Rectangle {
                        width: 156px;
                        height: 88px;
                        background: #0D0D0D;
                        border-radius: 4px;
                        clip: true;

                        if item.has-thumbnail : Image {
                            width: 100%;
                            height: 100%;
                            source: item.thumbnail;
                            image-fit: cover;
                        }

                        if !item.has-thumbnail : Rectangle {
                            background: #181818;
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: item.format-label;
                                    color: Theme.text-muted;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Badge de tipo no topo da miniatura
                        Rectangle {
                            x: 4px;
                            y: 4px;
                            PillBadge {
                                text: item.kind-label;
                                bg: item.is-clip ? Theme.accent-muted : Theme.surface-elevated;
                                fg: item.is-clip ? Theme.accent-hover : Theme.text-primary;
                                border-col: item.is-clip ? Theme.accent : Theme.border;
                            }
                        }

                        // Duração no rodapé da miniatura
                        Rectangle {
                            x: parent.width - self.width - 4px;
                            y: parent.height - self.height - 4px;
                            PillBadge {
                                text: item.duration-label;
                                bg: #000000;
                                fg: #FFFFFF;
                                border-col: #222222;
                            }
                        }
                    }

                    // Metadados centrais
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: item.title;
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            Text {
                                text: item.date-label;
                                color: Theme.text-secondary;
                                font-size: 12px;
                            }
                            Text {
                                text: "·";
                                color: Theme.text-muted;
                                font-size: 12px;
                            }
                            Text {
                                text: item.size-label;
                                color: Theme.text-muted;
                                font-size: 12px;
                            }
                            Text {
                                text: "·";
                                color: Theme.text-muted;
                                font-size: 12px;
                            }
                            Text {
                                text: item.format-label;
                                color: Theme.text-muted;
                                font-size: 12px;
                            }
                        }
                    }

                    // Ações e Confirmação Dupla à direita
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Se NÃO está em confirmação de exclusão para este item
                        if root.confirming-delete-path != item.path : HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            FlatButton {
                                text: "Abrir";
                                primary: true;
                                custom-height: 32px;
                                clicked => { root.open-media(item.path); }
                            }
                            FlatButton {
                                text: "Excluir";
                                primary: false;
                                danger: false;
                                custom-height: 32px;
                                clicked => { root.request-delete-media(item.path); }
                            }
                        }

                        // Se ESTÁ em confirmação de exclusão dupla para este item
                        if root.confirming-delete-path == item.path : HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: "Excluir?";
                                color: Theme.accent-hover;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            FlatButton {
                                text: "Confirmar";
                                primary: false;
                                danger: true;
                                custom-height: 32px;
                                clicked => { root.confirm-delete-media(item.path); }
                            }
                            FlatButton {
                                text: "Cancelar";
                                primary: false;
                                danger: false;
                                custom-height: 32px;
                                clicked => { root.cancel-delete-media(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
